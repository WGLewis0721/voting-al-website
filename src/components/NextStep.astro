---
const base=import.meta.env.BASE_URL;
---
<section class="py-12 md:py-16" aria-labelledby="next-step-title">
  <div class="section-wrap">
    <div class="glass-panel grid gap-6 p-6 md:grid-cols-[1fr_auto] md:items-center md:p-8">
      <div>
        <p class="section-eyebrow">Next step</p>
        <h2 id="next-step-title" class="font-display mt-3 text-4xl uppercase leading-[.95] md:text-5xl">Done reading? <em class="next-step__em">Go vote.</em></h2>
        <p class="mt-3 max-w-xl text-white/80">Polls are open 7 AM to 7 PM Central. Bring an accepted photo ID.</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row md:flex-col">
        <a class="btn gold justify-center" href="https://myinfo.alabamavotes.gov/VoterView" target="_blank" rel="noopener">Find my polling place <span aria-hidden="true">↗</span></a>
        <a class="btn ghost justify-center" href={`${base}counties`}>Open my sample ballot <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>
<style>
  .next-step__em { font-style:normal; display:inline-block; background:#e7ba54; color:#111; padding:0 .12em .04em; transform:skewX(-4deg); box-shadow:4px 4px 0 rgba(0,0,0,.6); }
  :global(html[data-theme="light"]) .next-step__em { box-shadow:4px 4px 0 rgba(33,24,8,.55); }
</style>
