---
import dates from '../data/dates.json';
---

<section class="relative overflow-hidden pb-16 pt-28 md:pb-20 md:pt-32">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_70%_20%,rgba(199,162,79,0.25),transparent_55%)]"></div>
  <div class="pointer-events-none absolute inset-0 opacity-[0.07] [background-image:linear-gradient(rgba(255,255,255,.25)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,.25)_1px,transparent_1px)] [background-size:58px_58px]"></div>
  <div class="section-wrap relative">
    <div class="absolute right-0 top-2 hidden h-32 w-32 animate-[spin_18s_linear_infinite] place-items-center rounded-full border border-gold/80 bg-black/50 text-center text-[10px] uppercase tracking-[0.16em] text-gold-soft backdrop-blur-sm md:grid">
      Plain language<br />Trusted context<br />No spin
    </div>
    <p class="section-eyebrow">Alabama 2026 Elections</p>
    <h1 class="font-display text-5xl leading-[0.88] tracking-tight md:text-7xl">Vote with <em class="text-gold-soft">clarity,</em><br />not confusion.</h1>
    <p class="mt-4 max-w-3xl text-white/75">Find what is on your ballot, compare candidates by issues you care about, and understand practical impacts in plain language before Election Day.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="#journey" class="btn gold">Start Your Voter Journey</a>
      <a href="#candidates" class="btn ghost">Compare Candidates</a>
    </div>

    <div class="glass-panel mt-8 grid grid-cols-2 gap-2 p-3 md:grid-cols-4">
      {dates.map((d) => (
        <article class="rounded-xl border border-white/10 bg-black/40 p-3">
          <p class="text-[10px] uppercase tracking-[0.14em] text-white/60">{d.label}</p>
          <p class="mt-1 text-sm font-semibold">{d.date}</p>
        </article>
      ))}
    </div>
  </div>
</section>
