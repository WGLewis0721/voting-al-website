---
import dates from '../data/dates.json';
---
<section class="relative overflow-hidden pb-16 pt-24 md:pb-24 md:pt-28">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_78%_20%,rgba(199,162,79,0.27),transparent_55%)]"></div>
  <div class="pointer-events-none absolute inset-0 opacity-[0.07] [background-image:linear-gradient(rgba(255,255,255,.25)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,.25)_1px,transparent_1px)] [background-size:58px_58px]"></div>
  <div class="section-wrap relative">
    <span class="inline-flex items-center gap-2 rounded-full border border-gold/50 bg-gold/10 px-4 py-2 text-[11px] font-bold uppercase tracking-[0.2em] text-gold-soft"><span class="inline-block h-2 w-2 animate-pulse rounded-full bg-gold"></span> Election Day · November 3, 2026</span>
    <div class="mt-7 max-w-5xl">
      <p class="section-eyebrow">Alabama General Election · Nonpartisan Guide</p>
      <h1 class="mt-3 font-display text-6xl leading-[0.88] tracking-tight md:text-8xl">Today's the day.<br /><em class="text-gold-soft">Know before you go.</em></h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/75">Polls are open from <strong class="text-white">7 AM to 7 PM Central</strong>. Find your assigned polling place, bring an accepted photo ID, and review the candidates and four statewide amendments before you cast your ballot.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="https://myinfo.alabamavotes.gov/VoterView" target="_blank" rel="noopener" class="btn gold">Find My Polling Place ↗</a>
        <a href="https://www.sos.alabama.gov/alabama-votes/2026-general-election-sample-ballots" target="_blank" rel="noopener" class="btn ghost">View Official Sample Ballot ↗</a>
      </div>
      <p class="mt-4 text-sm text-white/55">Already in line at 7 PM? Stay in line. If you do not have a photo ID, ask a poll worker about your options.</p>
    </div>
    <div class="glass-panel mt-10 grid grid-cols-2 gap-2 p-3 md:grid-cols-4" aria-label="Election day essentials">
      {dates.map(d => <article class="rounded-xl border border-white/10 bg-black/40 p-4"><p class="text-[10px] uppercase tracking-[0.14em] text-white/60">{d.label}</p><p class="mt-1 text-lg font-semibold">{d.date}</p></article>)}
    </div>
  </div>
</section>
