---
interface Candidate {
  id: string;
  name: string;
  party: string;
  office: string;
  district: string | null;
  sourceUrl: string;
  notes: string;
}

interface Props {
  office: string;
  district?: string;
  democraticCandidates: Candidate[];
  republicanCandidates: Candidate[];
  uncontested?: boolean;
  sourceDem?: string;
  sourceRep?: string;
}

const {
  office,
  district,
  democraticCandidates,
  republicanCandidates,
  uncontested = false,
  sourceDem = 'https://www.alabamademocrats.com/2026-qualified-candidates',
  sourceRep = 'https://algop.org/2026-qualified-candidates',
} = Astro.props;

const title = district ? `${office} — District ${district}` : office;
const totalCandidates = democraticCandidates.length + republicanCandidates.length;
---

<article class="glass-panel overflow-hidden">
  <div class="border-b border-white/10 px-5 py-4">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h3 class="font-display text-2xl leading-none md:text-3xl">{title}</h3>
      <div class="flex flex-wrap items-center gap-2">
        {uncontested && (
          <span class="rounded-full border border-gold/40 bg-gold/10 px-2.5 py-1 text-[10px] uppercase tracking-[0.14em] text-gold-soft">Uncontested</span>
        )}
        <span class="rounded-full border border-white/20 bg-white/5 px-2.5 py-1 text-[10px] uppercase tracking-[0.12em] text-white/55">
          {totalCandidates} candidate{totalCandidates !== 1 ? 's' : ''}
        </span>
      </div>
    </div>
  </div>

  <div class="grid gap-0 sm:grid-cols-2">
    <div class="border-b border-white/10 p-4 sm:border-b-0 sm:border-r">
      <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.16em] text-white/50">Democratic Primary</p>
      {democraticCandidates.length === 0 ? (
        <p class="text-sm text-white/35 italic">No Democratic candidates filed.</p>
      ) : (
        <ul class="space-y-2">
          {democraticCandidates.map((c) => (
            <li class="flex flex-col gap-0.5">
              <span class="font-medium text-white">{c.name}</span>
              {c.notes && <span class="text-xs text-white/50">{c.notes}</span>}
            </li>
          ))}
        </ul>
      )}
      {democraticCandidates.length > 0 && (
        <a
          href={sourceDem}
          target="_blank"
          rel="noopener"
          class="mt-3 inline-flex items-center gap-1 text-[11px] text-white/40 transition hover:text-gold-soft"
        >
          Source: Alabama Democratic Party
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      )}
    </div>

    <div class="p-4">
      <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.16em] text-white/50">Republican Primary</p>
      {republicanCandidates.length === 0 ? (
        <p class="text-sm text-white/35 italic">No Republican candidates filed.</p>
      ) : (
        <ul class="space-y-2">
          {republicanCandidates.map((c) => (
            <li class="flex flex-col gap-0.5">
              <span class="font-medium text-white">{c.name}</span>
              {c.notes && <span class="text-xs text-white/50">{c.notes}</span>}
            </li>
          ))}
        </ul>
      )}
      {republicanCandidates.length > 0 && (
        <a
          href={sourceRep}
          target="_blank"
          rel="noopener"
          class="mt-3 inline-flex items-center gap-1 text-[11px] text-white/40 transition hover:text-gold-soft"
        >
          Source: Alabama Republican Party
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      )}
    </div>
  </div>
</article>
