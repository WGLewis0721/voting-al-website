---
import CandidateCard from './CandidateCard.astro';
import candidates from '../data/candidates.json';
---

<section id="candidates" class="py-16 md:py-20">
  <div class="section-wrap">
    <p class="section-eyebrow">Interactive Candidate Explorer</p>
    <h2 class="section-title">Filter, search, compare.</h2>
    <p class="section-deck">Use party/race/issue controls and compare cards side-by-side before deciding.</p>

    <div class="sticky top-[67px] z-40 mt-8 rounded-2xl border border-white/10 bg-black/70 p-4 backdrop-blur-lg">
      <div class="grid gap-3 md:grid-cols-[1fr_1fr_1fr_auto]">
        <label class="text-sm text-white/70">Search
          <input id="searchInput" type="search" placeholder="Search candidate..." class="mt-1 w-full rounded-lg border border-white/20 bg-black/60 px-3 py-2 text-sm" />
        </label>
        <label class="text-sm text-white/70">Party
          <select id="partyFilter" class="mt-1 w-full rounded-lg border border-white/20 bg-black/60 px-3 py-2 text-sm">
            <option value="all">All parties</option>
            <option value="republican">Republican</option>
            <option value="democrat">Democrat</option>
          </select>
        </label>
        <label class="text-sm text-white/70">Race
          <select id="raceFilter" class="mt-1 w-full rounded-lg border border-white/20 bg-black/60 px-3 py-2 text-sm">
            <option value="all">All races</option>
            <option value="governor">Governor</option>
            <option value="u.s. senate">U.S. Senate</option>
          </select>
        </label>
        <button id="clearCandidateFilters" type="button" class="btn ghost h-fit self-end">Clear All</button>
      </div>

      <div class="mt-3 flex flex-wrap gap-2">
        {['economy', 'education', 'healthcare', 'safety', 'immigration'].map((issue) => (
          <button class="issue-pill rounded-full border border-white/25 px-3 py-1.5 text-xs uppercase tracking-[0.1em] text-white/75 transition hover:border-gold-soft hover:text-gold-soft" data-issue={issue} type="button">{issue}</button>
        ))}
      </div>
    </div>

    <div id="candidateGrid" class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {candidates.map((candidate) => <CandidateCard candidate={candidate} />)}
    </div>

    <div class="mt-5 flex items-center justify-between gap-3 rounded-xl border border-white/10 bg-black/50 p-3">
      <p class="text-sm text-white/70">Select two candidates to compare.</p>
      <button id="openCompare" type="button" class="btn gold">Compare Selected</button>
    </div>
  </div>

  <dialog id="compareDialog" class="w-[min(920px,92vw)] rounded-2xl border border-white/15 bg-graphite-900 p-0 text-white backdrop:bg-black/70">
    <div class="border-b border-white/10 p-4">
      <h3 class="font-display text-3xl">Side-by-side comparison</h3>
    </div>
    <div id="compareContent" class="grid gap-3 p-4 md:grid-cols-2"></div>
    <div class="border-t border-white/10 p-4 text-right">
      <button id="closeCompare" class="btn ghost" type="button">Close</button>
    </div>
  </dialog>
</section>

<script is:inline>
  const debounce = (fn, delay = 120) => {
    let timeoutId;
    return (...args) => {
      clearTimeout(timeoutId);
      timeoutId = setTimeout(() => fn(...args), delay);
    };
  };

  const cards = [...document.querySelectorAll('.candidate')];
  const searchInput = document.getElementById('searchInput');
  const partyFilter = document.getElementById('partyFilter');
  const raceFilter = document.getElementById('raceFilter');
  const clearCandidateFilters = document.getElementById('clearCandidateFilters');
  const issuePills = [...document.querySelectorAll('.issue-pill')];
  const openCompare = document.getElementById('openCompare');
  const closeCompare = document.getElementById('closeCompare');
  const compareDialog = document.getElementById('compareDialog');
  const compareContent = document.getElementById('compareContent');

  const selectedIssues = new Set();
  const selectedCards = new Set();

  const applyFilters = debounce(() => {
    const q = searchInput.value.trim().toLowerCase();
    const party = partyFilter.value;
    const race = raceFilter.value;

    cards.forEach((card) => {
      const cardText = card.textContent.toLowerCase();
      const cardParty = card.dataset.party;
      const cardRace = card.dataset.race;
      const cardIssues = (card.dataset.issues || '').split(',');

      const matchSearch = !q || cardText.includes(q);
      const matchParty = party === 'all' || cardParty === party;
      const matchRace = race === 'all' || cardRace === race;
      const matchIssue = selectedIssues.size === 0 || [...selectedIssues].every((issue) => cardIssues.includes(issue));

      card.hidden = !(matchSearch && matchParty && matchRace && matchIssue);
    });
  }, 130);

  searchInput?.addEventListener('input', applyFilters);
  partyFilter?.addEventListener('change', applyFilters);
  raceFilter?.addEventListener('change', applyFilters);

  clearCandidateFilters?.addEventListener('click', () => {
    searchInput.value = '';
    partyFilter.value = 'all';
    raceFilter.value = 'all';
    selectedIssues.clear();
    issuePills.forEach((pill) => pill.classList.remove('bg-gold', 'text-black', 'border-gold'));
    applyFilters();
  });

  issuePills.forEach((pill) => {
    pill.addEventListener('click', () => {
      const issue = pill.dataset.issue;
      if (selectedIssues.has(issue)) {
        selectedIssues.delete(issue);
        pill.classList.remove('bg-gold', 'text-black', 'border-gold');
      } else {
        selectedIssues.add(issue);
        pill.classList.add('bg-gold', 'text-black', 'border-gold');
      }
      applyFilters();
    });
  });

  cards.forEach((card) => {
    const toggle = card.querySelector('.candidate-toggle');
    const expand = card.querySelector('.candidate-expand');
    const name = card.querySelector('.name')?.textContent || '';

    toggle?.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      expand.style.maxHeight = isOpen ? '0px' : `${expand.scrollHeight + 16}px`;
    });

    card.addEventListener('click', (event) => {
      if (event.target.closest('.candidate-toggle')) return;
      if (selectedCards.has(card)) {
        selectedCards.delete(card);
        card.classList.remove('ring-2', 'ring-gold');
      } else if (selectedCards.size < 2) {
        selectedCards.add(card);
        card.classList.add('ring-2', 'ring-gold');
      }
      openCompare.textContent = selectedCards.size === 2 ? 'Compare Selected (2)' : 'Compare Selected';
      openCompare.disabled = selectedCards.size !== 2;
      card.setAttribute('aria-label', `${name} ${selectedCards.has(card) ? 'selected' : 'not selected'} for compare`);
    });
  });

  openCompare.disabled = true;
  const buildCompareCard = (card) => {
    const article = document.createElement('article');
    article.className = 'rounded-xl border border-white/10 bg-black/50 p-4';

    const heading = document.createElement('h4');
    heading.className = 'font-display text-3xl';
    heading.textContent = card.querySelector('.name')?.textContent?.trim() ?? '';

    const meta = document.createElement('p');
    meta.className = 'mt-1 text-sm text-white/70';
    meta.textContent = card.querySelector('.meta')?.textContent?.trim() ?? '';

    const details = document.createElement('div');
    details.className = 'mt-3 text-sm text-white/80';
    const detailsSource = card.querySelector('.candidate-expand > div');
    if (detailsSource) {
      details.append(detailsSource.cloneNode(true));
    }

    article.append(heading, meta, details);
    return article;
  };

  openCompare?.addEventListener('click', () => {
    if (selectedCards.size !== 2) return;
    const [a, b] = [...selectedCards];
    compareContent.replaceChildren(buildCompareCard(a), buildCompareCard(b));
    compareDialog.showModal();
  });
  closeCompare?.addEventListener('click', () => compareDialog.close());
</script>
