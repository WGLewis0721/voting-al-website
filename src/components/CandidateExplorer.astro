---
import CandidateCard from './CandidateCard.astro';
import candidates from '../data/candidates.json';

const base = import.meta.env.BASE_URL;

type Candidate = {
  id: string;
  name: string;
  party: string;
  office: string;
  district: string | null;
  sourceUrl: string;
  notes: string;
};

const allCandidates = candidates as Candidate[];
const uniqueOffices = [...new Set(allCandidates.map((c) => c.office))].sort();
---

<section id="candidates" class="py-16 md:py-20">
  <div class="section-wrap">
    <p class="section-eyebrow">Who's Running</p>
    <h2 class="section-title">2026 Primary Candidates.</h2>
    <p class="section-deck">Filter by party or office. For the full race-by-race breakdown, visit the <a href={`${base}candidates`} class="text-gold-soft underline hover:text-gold">Candidates page</a>.</p>

    <div class="z-40 mt-8 rounded-2xl border border-white/10 bg-black/70 p-4 backdrop-blur-lg md:sticky md:top-[67px]">
      <div class="grid gap-3 md:grid-cols-[1fr_1fr_1fr_auto]">
        <label class="text-sm text-white/70">Search
          <input id="searchInput" type="search" placeholder="Search candidate..." class="mt-1 w-full rounded-lg border border-white/20 bg-black/60 px-3 py-2 text-sm" />
        </label>
        <label class="text-sm text-white/70">Party
          <select id="partyFilter" class="mt-1 w-full rounded-lg border border-white/20 bg-black/60 px-3 py-2 text-sm">
            <option value="all">All parties</option>
            <option value="republican">Republican</option>
            <option value="democratic">Democratic</option>
          </select>
        </label>
        <label class="text-sm text-white/70">Office
          <select id="officeFilter" class="mt-1 w-full rounded-lg border border-white/20 bg-black/60 px-3 py-2 text-sm">
            <option value="all">All offices</option>
            {uniqueOffices.map((office) => (
              <option value={office.toLowerCase()}>{office}</option>
            ))}
          </select>
        </label>
        <button id="clearCandidateFilters" type="button" class="btn ghost h-fit self-end">Clear All</button>
      </div>
    </div>

    <div id="candidateGrid" class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {allCandidates.map((candidate) => <CandidateCard candidate={candidate} />)}
    </div>

    <p id="noResults" class="mt-6 hidden text-center text-white/55">No candidates match your filters.</p>

    <div class="mt-6 text-center">
      <a href={`${base}candidates`} class="btn gold">View Full Candidate List by Race</a>
    </div>
  </div>
</section>

<script is:inline>
  const debounce = (fn, delay = 120) => {
    let timeoutId;
    return (...args) => {
      clearTimeout(timeoutId);
      timeoutId = setTimeout(() => fn(...args), delay);
    };
  };

  const cards = [...document.querySelectorAll('.candidate')];
  const searchInput = document.getElementById('searchInput');
  const partyFilter = document.getElementById('partyFilter');
  const officeFilter = document.getElementById('officeFilter');
  const clearCandidateFilters = document.getElementById('clearCandidateFilters');
  const noResults = document.getElementById('noResults');

  const applyFilters = debounce(() => {
    const q = searchInput.value.trim().toLowerCase();
    const party = partyFilter.value;
    const office = officeFilter.value;

    let visible = 0;
    cards.forEach((card) => {
      const cardText = card.textContent.toLowerCase();
      const cardParty = card.dataset.party;
      const cardOffice = card.dataset.office;

      const matchSearch = !q || cardText.includes(q);
      const matchParty = party === 'all' || cardParty === party;
      const matchOffice = office === 'all' || cardOffice === office;

      const show = matchSearch && matchParty && matchOffice;
      card.hidden = !show;
      if (show) visible++;
    });

    if (noResults) noResults.classList.toggle('hidden', visible > 0);
  }, 130);

  searchInput?.addEventListener('input', applyFilters);
  partyFilter?.addEventListener('change', applyFilters);
  officeFilter?.addEventListener('change', applyFilters);

  clearCandidateFilters?.addEventListener('click', () => {
    searchInput.value = '';
    partyFilter.value = 'all';
    officeFilter.value = 'all';
    applyFilters();
  });
</script>
