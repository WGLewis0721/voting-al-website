---
interface Candidate {
  id: string;
  name: string;
  race: string;
  party: string;
  tagline: string;
  issues: string[];
  positions: string[];
  whyItMatters: string;
}

const { candidate } = Astro.props as { candidate: Candidate };
const partyClass = candidate.party === 'Democrat' ? 'bg-gradient-to-r from-blue-500 to-blue-700' : 'bg-gradient-to-r from-red-500 to-red-700';
---

<article class="candidate glass-panel overflow-hidden" data-issues={candidate.issues.join(',')} data-race={candidate.race.toLowerCase()} data-party={candidate.party.toLowerCase()}>
  <div class:list={['h-1.5', partyClass]}></div>
  <div class="p-4">
    <p class="meta text-[11px] uppercase tracking-[0.16em] text-white/55">{candidate.race} · {candidate.party}</p>
    <h3 class="name mt-1 font-display text-3xl leading-none">{candidate.name}</h3>
    <p class="mt-2 text-sm text-white/70">{candidate.tagline}</p>
    <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-white/75">
      {candidate.positions.map((p) => <li>{p}</li>)}
    </ul>
  </div>
  <button class="candidate-toggle flex w-full items-center justify-between border-t border-white/10 bg-black/30 px-4 py-3 text-left text-xs font-semibold uppercase tracking-[0.1em] text-gold-soft" type="button" aria-expanded="false">
    <span>Positions & Why It Matters</span>
    <span>▾</span>
  </button>
  <div class="candidate-expand max-h-0 overflow-hidden px-4 text-sm text-white/75 transition-all duration-300">
    <div class="my-4 rounded-lg border border-gold/25 bg-gold/10 p-3">
      <p><strong class="text-gold-soft">Why this matters:</strong> {candidate.whyItMatters}</p>
    </div>
  </div>
</article>
