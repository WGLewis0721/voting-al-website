---
interface Candidate {
  id: string;
  name: string;
  party: string;
  office: string;
  district: string | null;
  sourceUrl: string;
  notes: string;
}

const { candidate } = Astro.props as { candidate: Candidate };
const partyClass = candidate.party === 'Democratic' ? 'party-dem' : candidate.party === 'Republican' ? 'party-rep' : '';
const officeLabel = candidate.district
  ? `${candidate.office} — District ${candidate.district}`
  : candidate.office;
---

<article
  class={`candidate glass-panel party-card overflow-hidden ${partyClass}`}
  data-party={candidate.party.toLowerCase()}
  data-office={candidate.office.toLowerCase()}
  data-district={candidate.district ?? ''}
>
  <div class="party-accent-bar" aria-hidden="true"></div>
  <div class="p-4">
    <div class="party-eyebrow"><span class="meta text-xs uppercase tracking-[0.12em] text-white/60">{officeLabel}</span><span class="party-badge">{candidate.party}</span></div>
    <h3 class="party-name name mt-3 font-display text-3xl leading-none">{candidate.name}</h3>
    {candidate.notes && <p class="mt-1.5 text-xs text-white/55">{candidate.notes}</p>}
  </div>
  <div class="border-t border-white/10 px-4 py-2.5">
    <a
      href={candidate.sourceUrl}
      target="_blank"
      rel="noopener"
      class="party-link inline-flex min-h-11 items-center gap-1 text-xs transition"
    >
      Source: Alabama SOS 2026 election information
      <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </a>
  </div>
</article>
