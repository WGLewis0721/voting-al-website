---
interface Candidate {
  id: string;
  name: string;
  party: string;
  office: string;
  district: string | null;
  sourceUrl: string;
  notes: string;
}

const { candidate } = Astro.props as { candidate: Candidate };
const officeLabel = candidate.district
  ? `${candidate.office} — District ${candidate.district}`
  : candidate.office;
---

<article
  class="candidate glass-panel overflow-hidden"
  data-party={candidate.party.toLowerCase()}
  data-office={candidate.office.toLowerCase()}
  data-district={candidate.district ?? ''}
>
  <div
    class:list={[
      'h-1',
      candidate.party === 'Republican'
        ? 'bg-gradient-to-r from-red-500/90 to-red-400/60'
        : 'bg-gradient-to-r from-blue-500/90 to-blue-400/60',
    ]}
  ></div>
  <div class="p-4">
    <p class="meta text-[11px] uppercase tracking-[0.16em] text-white/55">{officeLabel} · {candidate.party}</p>
    <h3 class="name mt-1 font-display text-2xl leading-none">{candidate.name}</h3>
    {candidate.notes && <p class="mt-1.5 text-xs text-white/55">{candidate.notes}</p>}
  </div>
  <div class="border-t border-white/10 px-4 py-2.5">
    <a
      href={candidate.sourceUrl}
      target="_blank"
      rel="noopener"
      class="inline-flex items-center gap-1 text-[11px] text-white/40 transition hover:text-gold-soft"
    >
      Source: {candidate.party === 'Democratic' ? 'Alabama Democratic Party' : 'Alabama Republican Party'}
      <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </a>
  </div>
</article>
