---
interface Props {
  currentPage?: string;
}

const { currentPage = '' } = Astro.props;
const base = import.meta.env.BASE_URL;

const navLinks = [
  
  { href: `${base}candidates`, label: 'Candidates' },
  { href: `${base}amendments`, label: 'Amendments' },
  { href: `${base}counties`, label: 'Counties' },
  { href: `${base}voter-guide`, label: 'Voter Guide' },
  { href: `${base}primary-2026`, label: 'Primary Archive' },
];
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-black/80 backdrop-blur-lg">
  <div class="section-wrap flex min-h-[68px] items-center justify-between gap-2 sm:gap-4">
    <a href={base} class="inline-flex min-h-11 flex-col justify-center whitespace-nowrap font-display text-xl font-black uppercase leading-none tracking-tight sm:text-3xl">
      Alabama Votes
      <span class="block font-sans mt-1 text-xs uppercase tracking-[0.08em] text-gold-soft">2026 Voter Guide</span>
    </a>

    <nav class="hidden flex-wrap gap-1 text-xs uppercase tracking-[0.1em] text-white/65 md:flex" aria-label="Main navigation">
      {navLinks.map((link) => (
        <a
          class={`inline-flex min-h-11 items-center rounded-full px-3 transition hover:bg-white/10 hover:text-white ${currentPage === link.label ? 'bg-white/10 text-white' : ''}`}
          href={link.href}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-1.5 sm:gap-2">
      <button id="themeToggle" class="color-mode-toggle" type="button" aria-label="Switch color theme" title="Switch color theme">
        <svg class="color-mode-toggle__sun" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/>
        </svg>
        <svg class="color-mode-toggle__moon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.6 14.4A8.7 8.7 0 0 1 9.6 3.4 8.7 8.7 0 1 0 20.6 14.4Z"/>
        </svg>
      </button>
      <button
        id="mobileMenuBtn"
        type="button"
        class="flex h-11 w-11 items-center justify-center rounded-full border border-white/20 text-white/70 transition hover:bg-white/10 md:hidden"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobileMenu"
      >
        <svg id="menuIconOpen" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menuIconClose" xmlns="http://www.w3.org/2000/svg" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      <a href="https://myinfo.alabamavotes.gov/VoterView" target="_blank" rel="noopener" class="btn gold min-h-11 whitespace-nowrap px-3 text-xs tracking-[0.06em] sm:px-4"><span class="hidden sm:inline">Find Polling Place</span><span class="sm:hidden">Find Polls</span></a>
    </div>
  </div>

  <div
    id="mobileMenu"
    class="hidden border-t border-white/10 bg-black/90 px-4 pb-4 md:hidden"
  >
    <nav class="flex flex-col gap-1 pt-3" aria-label="Mobile navigation">
      {navLinks.map((link) => (
        <a
          class={`flex min-h-11 items-center rounded-lg px-3 text-sm uppercase tracking-[0.1em] transition hover:bg-white/10 hover:text-white ${currentPage === link.label ? 'bg-white/10 text-white' : 'text-white/70'}`}
          href={link.href}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script is:inline>
  const btn = document.getElementById('mobileMenuBtn');
  const menu = document.getElementById('mobileMenu');
  const iconOpen = document.getElementById('menuIconOpen');
  const iconClose = document.getElementById('menuIconClose');

  const themeButton = document.getElementById('themeToggle');
  const themeKey = 'alabama-votes-color-mode';
  const syncThemeButton = () => {
    const current = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
    const label = current === 'light' ? 'Switch to dark mode' : 'Switch to light mode';
    themeButton?.setAttribute('aria-label', label);
    themeButton?.setAttribute('title', label);
  };
  syncThemeButton();
  themeButton?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem(themeKey, next); } catch {}
    syncThemeButton();
  });

  btn?.addEventListener('click', () => {
    const isOpen = menu.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(isOpen));
    iconOpen.classList.toggle('hidden', isOpen);
    iconClose.classList.toggle('hidden', !isOpen);
  });
</script>

<style>
  .color-mode-toggle {
    display:inline-flex;
    align-items:center;
    justify-content:center;
    width:44px;
    height:44px;
    flex:none;
    border-radius:999px;
    border:1px solid rgba(228,199,127,.52);
    background:rgba(255,255,255,.045);
    color:#f5d88c;
    cursor:pointer;
    transition:background .18s ease,border-color .18s ease,transform .18s ease;
  }
  .color-mode-toggle:hover { background:rgba(228,199,127,.16); border-color:#e4c77f; transform:translateY(-1px); }
  .color-mode-toggle__moon { display:none; }
  html[data-theme="light"] .color-mode-toggle {
    background:#fff9eb;
    color:#49330b;
    border-color:#ba8c40;
  }
  html[data-theme="light"] .color-mode-toggle__sun { display:none; }
  html[data-theme="light"] .color-mode-toggle__moon { display:block; }
  html[data-theme="light"] .color-mode-toggle:hover { background:#f2e4c6; }
  @media(prefers-reduced-motion:reduce) {.color-mode-toggle:hover{transform:none}}
</style>
