---
import issues from '../data/issues.json';
---

<section id="issues" class="py-16 md:py-20">
  <div class="section-wrap">
    <p class="section-eyebrow">Key Issues</p>
    <h2 class="section-title">What matters to Alabama voters.</h2>
    <p class="section-deck">Clear issue framing to help you connect campaign rhetoric to everyday outcomes for your family and community.</p>
    <div class="mt-8 grid gap-3 md:grid-cols-2 lg:grid-cols-3">
      {issues.map((issue) => (
        <article class="glass-panel p-4">
          <h3 class="font-display text-3xl leading-none">{issue.title}</h3>
          <p class="mt-2 text-sm text-white/75">{issue.summary}</p>
        </article>
      ))}
    </div>
  </div>
</section>
