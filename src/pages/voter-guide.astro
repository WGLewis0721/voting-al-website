---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import TrustBanner from '../components/TrustBanner.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import NextStep from '../components/NextStep.astro';
const links=[
{title:'Find my polling place',url:'https://myinfo.alabamavotes.gov/VoterView',desc:'Official registration and assigned polling place lookup'},
{title:'County sample ballots',url:'https://www.sos.alabama.gov/alabama-votes/2026-general-election-sample-ballots',desc:'Official 2026 general-election ballots'},
{title:'Accepted photo identification',url:'https://www.sos.alabama.gov/alabama-votes/voter/voter-id',desc:'Valid IDs, provisional voting and exceptions'},
{title:'Absentee voting',url:'https://www.sos.alabama.gov/alabama-votes/voter/absentee-voting',desc:'Official absentee requirements and county manager information'},
{title:'Four statewide amendments',url:'https://www.sos.alabama.gov/alabama-votes/voter/ballot-measures/statewide',desc:'Alabama Fair Ballot Commission statements'},
{title:'2026 election information',url:'https://www.sos.alabama.gov/alabama-votes/voter/election-information/2026',desc:'State-certified candidates and election publications'}
];
---
<Layout title="Election Day Guide · November 3, 2026 | Alabama Votes" description="2026 Alabama General Election guide: polls, photo voter ID, registration, absentee deadlines, provisional voting and official ballot lookup.">
  <TrustBanner /><SiteHeader currentPage="Voter Guide" />
  <main id="main">
    <section class="relative overflow-hidden pb-12 pt-20 md:pt-24">
      <div class="section-wrap">
        <p class="section-eyebrow">Tuesday · November 3, 2026</p>
        <h1 class="font-display text-5xl leading-[0.9] tracking-tight md:text-7xl">Election Day.<br/><em class="text-gold-soft">Your field guide.</em></h1>
        <p class="mt-5 max-w-2xl text-white/75">Everything to know before you walk into your Alabama polling place today, with direct links to the state's official resources.</p>
        <div class="mt-7 flex flex-wrap gap-3"><a class="btn gold" href="https://myinfo.alabamavotes.gov/VoterView" target="_blank" rel="noopener">Find My Polling Place <Icon name="ne" /></a><a class="btn ghost" href="https://www.sos.alabama.gov/alabama-votes/2026-general-election-sample-ballots" target="_blank" rel="noopener">View Sample Ballot <Icon name="ne" /></a></div>
      </div>
    </section>
    <section class="py-10">
      <div class="section-wrap">
        <div class="grid gap-4 sm:grid-cols-3">
          <div class="glass-panel p-6"><p class="section-eyebrow">Polls open</p><p class="mt-2 font-display text-4xl">7:00 AM</p><p class="mt-1 text-sm text-white/60">Central time</p></div>
          <div class="glass-panel p-6"><p class="section-eyebrow">Polls close</p><p class="mt-2 font-display text-4xl">7:00 PM</p><p class="mt-1 text-sm text-white/60">If in line by closing, stay in line</p></div>
          <div class="glass-panel p-6"><p class="section-eyebrow">Take with you</p><p class="mt-2 font-display text-4xl">Photo ID</p><p class="mt-1 text-sm text-white/60">An accepted form of ID</p></div>
        </div>
      </div>
    </section>
    <section class="py-12 md:py-16">
      <div class="section-wrap">
        <p class="section-eyebrow">Before voting</p><h2 class="section-title">What to do today.</h2>
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          <article class="glass-panel p-6"><h3 class="font-display text-3xl">01. Check your polling place</h3><p class="mt-3 text-sm leading-relaxed text-white/70">You must vote at your assigned precinct. Use the official VoterView lookup for your registration status and location.</p><a class="mt-2 inline-flex min-h-11 items-center text-sm text-gold-soft underline" target="_blank" rel="noopener" href="https://myinfo.alabamavotes.gov/VoterView">Official polling-place lookup <Icon name="ne" /></a></article>
          <article class="glass-panel p-6"><h3 class="font-display text-3xl">02. Know your ballot</h3><p class="mt-3 text-sm leading-relaxed text-white/70">Alabama's ballot includes statewide, federal, legislative, judicial and potentially local offices, plus four statewide proposed constitutional amendments. Your exact choices depend on your residence.</p><a class="mt-2 inline-flex min-h-11 items-center text-sm text-gold-soft underline" target="_blank" rel="noopener" href="https://www.sos.alabama.gov/alabama-votes/2026-general-election-sample-ballots">Official county sample ballots <Icon name="ne" /></a></article>
          <article class="glass-panel p-6"><h3 class="font-display text-3xl">03. Bring accepted photo ID</h3><p class="mt-3 text-sm leading-relaxed text-white/70">Examples include an eligible Alabama driver's license or non-driver ID, a U.S. passport, military ID, Alabama photo voter ID, and several other listed forms. Some Alabama licenses or non-driver IDs expired fewer than 60 days are accepted.</p><a class="mt-2 inline-flex min-h-11 items-center text-sm text-gold-soft underline" target="_blank" rel="noopener" href="https://www.sos.alabama.gov/alabama-votes/voter/voter-id">Full list of accepted photo IDs <Icon name="ne" /></a></article>
          <article class="glass-panel p-6"><h3 class="font-display text-3xl">04. Don't leave without asking</h3><p class="mt-3 text-sm leading-relaxed text-white/70">If an ID is missing or your eligibility is questioned, ask a poll worker about a provisional ballot. For a provisional ballot issued because of missing photo ID, you generally need to provide an accepted photo ID to your Board of Registrars by <strong class="text-white">5 PM Friday, November 6</strong>. The state also has a two-election-official identification procedure.</p><a class="mt-2 inline-flex min-h-11 items-center text-sm text-gold-soft underline" target="_blank" rel="noopener" href="https://www.sos.alabama.gov/alabama-votes/voter/voter-id">Read the official rules <Icon name="ne" /></a></article>
        </div>
      </div>
    </section>
    <section class="py-12 md:py-16">
      <div class="section-wrap">
        <p class="section-eyebrow">Deadlines and exceptions</p><h2 class="section-title">Time-sensitive reminders.</h2>
        <div class="mt-6 grid gap-4 md:grid-cols-3">
          <article class="glass-panel p-5"><h3 class="font-semibold">Registration deadline passed</h3><p class="mt-2 text-sm text-white/70">The registration deadline for this election was October 19, 2026. Alabama does not offer Election Day registration. Already registered? Check your status at VoterView.</p></article>
          <article class="glass-panel p-5"><h3 class="font-semibold">Absentee ballots by mail</h3><p class="mt-2 text-sm text-white/70">For standard absentee ballots mailed back, the absentee election manager must receive the ballot by <strong class="text-white">noon November 3</strong>. The standard in-person return deadline was November 2. Other rules may apply to eligible voters such as military and overseas voters.</p></article>
          <article class="glass-panel p-5"><h3 class="font-semibold">Know where to get help</h3><p class="mt-2 text-sm text-white/70">If you encounter a problem, ask the precinct poll workers or contact your county election officials. The Alabama Secretary of State's Elections Division can be reached at <a class="text-gold-soft underline" href="tel:+13342427210">334-242-7210</a>.</p></article>
        </div>
      </div>
    </section>
    <section class="py-12 md:py-16">
      <div class="section-wrap">
        <p class="section-eyebrow">Official links</p><h2 class="section-title">Go to the source.</h2>
        <div class="mt-7 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">{links.map(link=><a class="glass-panel block p-5 transition hover:border-gold/60" href={link.url} target="_blank" rel="noopener"><h3 class="font-semibold text-white">{link.title}  <Icon name="ne" /></h3><p class="mt-2 text-sm text-white/60">{link.desc}</p></a>)}</div>
        <p class="mt-7 rounded-xl border border-white/15 bg-white/5 p-4 text-sm text-white/60">Independent, nonpartisan voter education. Not affiliated with Alabama election officials. Verify all details with official sources. Last reviewed November 3, 2026.</p>
      </div>
    </section>
  <NextStep />
  </main><SiteFooter />
</Layout>
