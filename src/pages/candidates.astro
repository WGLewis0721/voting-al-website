---
import Layout from '../layouts/Layout.astro';
import TrustBanner from '../components/TrustBanner.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import NextStep from '../components/NextStep.astro';
import RaceSection from '../components/RaceSection.astro';
import candidates from '../data/candidates.json';
const races=['U.S. Senate','Governor','Lieutenant Governor','Attorney General','Secretary of State','State Treasurer','State Auditor','Commissioner of Agriculture & Industries','Public Service Commission, Place 1','Public Service Commission, Place 2'];
const all=candidates;
const sos='https://www.sos.alabama.gov/alabama-votes/voter/election-information/2026';
---
<Layout title="2026 Alabama General Election Candidates | Nonpartisan Guide" description="The major statewide Alabama November 3 general election candidates by race and party, plus official sample ballot links for district, local, judicial, and other contests.">
  <TrustBanner /><SiteHeader currentPage="Candidates" />
  <main id="main">
    <section class="relative overflow-hidden pb-8 pt-20 md:pt-24">
      <div class="section-wrap">
        <p class="section-eyebrow">November 3, 2026 · General Election</p>
        <h1 class="font-display text-5xl leading-[0.9] tracking-tight md:text-7xl">Who's on the<br /><em class="text-gold-soft">ballot today?</em></h1>
        <p class="mt-5 max-w-2xl text-white/70">A nonpartisan snapshot of Democratic and Republican nominees in ten prominent statewide races. This is not the full candidate list for every address or voting district.</p>
        <div class="party-key mt-6" aria-label="Party color legend"><span class="party-key__item party-dem"><span class="party-key__dot" aria-hidden="true"></span>Democratic · Blue</span><span class="party-key__item party-rep"><span class="party-key__dot" aria-hidden="true"></span>Republican · Red</span></div>
        <div class="mt-6 flex flex-wrap gap-3"><a href="https://www.sos.alabama.gov/alabama-votes/2026-general-election-sample-ballots" target="_blank" rel="noopener" class="btn gold">Check My Official Ballot ↗</a><a href={sos} target="_blank" rel="noopener" class="btn ghost">SOS Candidate Certifications ↗</a></div>
      </div>
    </section>
    <section class="py-6">
      <div class="section-wrap">
        <p class="rounded-xl border border-gold/30 bg-gold/8 p-5 text-sm text-white/75"><strong class="text-gold-soft">Scope:</strong> The list below features major-party statewide nominees. Congressional, legislative, judicial, independent, write-in, uncontested and local races may also apply. Check your county's official general-election ballot for the authoritative list. No candidate is endorsed.</p>
      </div>
    </section>
    <section class="py-10 md:py-16">
      <div class="section-wrap">
        <div class="glass-panel p-4"><label class="block text-xs font-semibold uppercase tracking-widest text-white/60" for="raceSearch">Search races or candidate names</label><input class="mt-2 w-full rounded-lg border border-white/20 bg-black/60 px-4 py-3" type="search" id="raceSearch" placeholder="Try governor, Senate, Barry Moore…"/></div>
        <p id="emptyRaces" class="mt-6 hidden text-sm text-white/55">No matches. Try a different name or office.</p>
        <div class="mt-6 grid gap-4" id="raceList">
          {races.map(office => {
            const dems=all.filter(c=>c.office===office&&c.party==='Democratic');
            const reps=all.filter(c=>c.office===office&&c.party==='Republican');
            return <div class="race-search-item" data-search={`${office} ${dems.map(c=>c.name).join(' ')} ${reps.map(c=>c.name).join(' ')}`.toLowerCase()}><RaceSection office={office} democraticCandidates={dems} republicanCandidates={reps} sourceDem={sos} sourceRep={sos}/></div>
          })}
        </div>
        <div class="mt-8 glass-panel p-6">
          <p class="section-eyebrow">Beyond these races</p>
          <h2 class="font-display text-3xl">What about my district?</h2>
          <p class="mt-3 text-sm text-white/70">Your ballot may also include U.S. House, Alabama Legislature, judicial offices, local contests, and local amendments. Do not use this statewide overview as a substitute for the official ballot for your address.</p>
          <a class="btn gold mt-5 inline-flex" href="https://www.sos.alabama.gov/alabama-votes/2026-general-election-sample-ballots" target="_blank" rel="noopener">Find My County Sample Ballot ↗</a>
        </div>
      </div>
    </section>
  <NextStep />
  </main><SiteFooter />
</Layout>
<script is:inline>
const raceInput=document.getElementById('raceSearch'),raceItems=[...document.querySelectorAll('.race-search-item')],none=document.getElementById('emptyRaces');
raceInput?.addEventListener('input',()=>{
  const query=raceInput.value.trim().toLowerCase();let visible=0;
  raceItems.forEach(item=>{let show=item.dataset.search.includes(query);item.hidden=!show;if(show)visible++});
  none?.classList.toggle('hidden',visible!==0);
});
</script>
