---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import TrustBanner from '../components/TrustBanner.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import counties from '../data/counties.json';
import ballots from '../data/county-ballots.json';
import CountyMap from '../components/CountyMap.astro';

const base = import.meta.env.BASE_URL;
const sosBallotsUrl = 'https://www.sos.alabama.gov/alabama-votes/2026-general-election-sample-ballots';
---

<Layout
  title="County Sample Ballots — Alabama Votes"
  description="Find your county's 2026 Alabama general election sample ballot. Official links to the Alabama Secretary of State sample ballots for all 67 Alabama counties."
>
  <TrustBanner />
  <SiteHeader currentPage="Counties" />

  <main id="main">
    <section class="relative overflow-hidden pb-10 pt-20 md:pt-24">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_60%_0%,rgba(199,162,79,0.15),transparent_55%)]"></div>
      <div class="section-wrap relative">
        <p class="section-eyebrow">County Sample Ballots</p>
        <h1 class="font-display text-5xl leading-[0.9] tracking-tight md:text-7xl">Find Your<br /><em class="text-gold-soft">County Ballot.</em></h1>
        <p class="mt-4 max-w-2xl text-white/75">Tap your county to open its official Alabama Secretary of State sample ballot. The official sample ballots show general-election contests and questions, which can vary by county and voting district.</p>
      </div>
    </section>

    <section class="py-6">
      <div class="section-wrap">
        <div class="rounded-xl border border-gold/30 bg-gold/8 px-5 py-4 text-sm text-white/75">
          <strong class="text-gold-soft"><Icon name="warn" /> Important:</strong> Candidate lists and ballot content can vary by county and district. Always verify your final ballot using the official Alabama Secretary of State sample ballot for your county.
        </div>
      </div>
    </section>

    <!-- County finder: map plus list, one shared selection -->
    <section id="county-finder" class="scroll-mt-24 py-10 md:py-14">
      <div class="section-wrap">
        <p class="section-eyebrow">Sample Ballot Finder</p>
        <h2 class="section-title">Tap your <em>county.</em></h2>
        <p class="section-deck">Tap your county on the map, or pick it from the list. Then open its official sample ballot (PDF) from the Alabama Secretary of State.</p>

        <div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(320px,440px)] lg:items-start">
          <div class="glass-panel p-5 md:p-6 lg:order-2 lg:sticky lg:top-24">
            <label for="countySelect" class="mb-2 block font-medium text-white/90">Your county</label>
            <select id="countySelect" class="min-h-12 w-full rounded-lg border border-white/20 bg-black/60 px-3 py-3 text-base">
              <option value="">Choose your county</option>
              {counties.map((county) => <option value={county}>{county} County</option>)}
            </select>
            <p id="countyStatus" class="mt-3 min-h-6 font-semibold text-gold-soft" aria-live="polite">No county selected yet.</p>
            <a id="ballotLinkBtn" href={sosBallotsUrl} target="_blank" rel="noopener" class="btn gold mt-3 w-full justify-center py-3 text-sm">Browse all official ballots <Icon name="ne" /></a>
            <p id="ballotInfo" class="mt-4 text-white/70">Your voting district may determine the exact ballot style, so check that it matches your address.</p>
          </div>
          <div class="glass-panel p-3 md:p-5 lg:order-1">
            <CountyMap />
            <p class="mt-3 text-center text-white/60">Small counties hard to tap? Use the county list instead.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-10 md:py-14">
      <div class="section-wrap">
        <div class="glass-panel p-5">
          <p class="section-eyebrow">About Sample Ballots</p>
          <div class="mt-4 grid gap-4 md:grid-cols-2 text-sm text-white/70">
            <div>
              <h3 class="font-semibold text-white">What is a sample ballot?</h3>
              <p class="mt-1">A sample ballot shows you the exact races, candidates, and questions that will appear on your official ballot before you arrive at the polls. It helps you research and prepare.</p>
            </div>
            <div>
              <h3 class="font-semibold text-white">Where can I find mine?</h3>
              <p class="mt-1">The Alabama Secretary of State publishes official sample ballots for each county. General-election ballots can vary by county and district. Select the ballot style that applies to your address.</p>
            </div>
            <div>
              <h3 class="font-semibold text-white">Why does it vary by county?</h3>
              <p class="mt-1">Local races — school boards, county commissions, circuit courts, and other offices — differ by county. Your sample ballot shows what is specific to your area.</p>
            </div>
            <div>
              <h3 class="font-semibold text-white">Official source</h3>
              <a href={sosBallotsUrl} target="_blank" rel="noopener" class="mt-1 flex min-h-11 items-center gap-1 text-gold-soft hover:underline">
                Alabama SOS 2026 General Sample Ballots
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<script is:inline define:vars={{ ballots, sosBallotsUrl }}>
  (() => {
    const select = document.getElementById('countySelect');
    const btn = document.getElementById('ballotLinkBtn');
    const status = document.getElementById('countyStatus');
    const svg = document.querySelector('#countyMap svg');
    const paths = Array.from(document.querySelectorAll('.county'));
    const arrow = btn ? btn.querySelector('svg')?.outerHTML ?? '' : '';

    function choose(name) {
      const hit = paths.find((p) => p.dataset.county === name);
      paths.forEach((p) => { const on = p === hit; p.classList.toggle('is-selected', on); p.setAttribute('aria-pressed', String(on)); });
      if (hit) svg.appendChild(hit); // draw the selected county on top
      if (select) select.value = hit ? name : '';
      if (hit && ballots[name]) {
        btn.href = ballots[name];
        btn.innerHTML = 'Open ' + name + ' County sample ballot ' + arrow;
        status.textContent = name + ' County selected.';
      } else {
        btn.href = sosBallotsUrl;
        btn.innerHTML = 'Browse all official ballots ' + arrow;
        status.textContent = 'No county selected yet.';
      }
    }

    paths.forEach((p) => {
      p.addEventListener('click', () => choose(p.dataset.county));
      p.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); choose(p.dataset.county); } });
    });
    select?.addEventListener('change', () => choose(select.value));

    // A county chosen in the homepage hero is carried into this finder.
    const requested = new URLSearchParams(window.location.search).get('county');
    if (requested && paths.some((p) => p.dataset.county === requested)) choose(requested);
  })();
</script>
