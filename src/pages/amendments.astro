---
import Layout from '../layouts/Layout.astro';
import TrustBanner from '../components/TrustBanner.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import NextStep from '../components/NextStep.astro';
import AmendmentsShowcase from '../components/AmendmentsShowcase.astro';
const ballotUrl='https://www.sos.alabama.gov/alabama-votes/2026-general-election-sample-ballots';
---
<Layout
 title="Four Constitutional Amendments | Alabama Votes 2026"
 description="Explore Alabama's four November 3, 2026 constitutional amendments with clear summaries, key details, and side-by-side YES / NO outcomes. Read official Fair Ballot Commission statements."
>
  <TrustBanner />
  <SiteHeader currentPage="Amendments" />
  <main id="main">
    <AmendmentsShowcase />
    <section class="py-14 md:py-20">
      <div class="section-wrap">
        <p class="section-eyebrow">How the ballot works</p>
        <h2 class="section-title">Make each choice on its own terms.</h2>
        <p class="section-deck">Each constitutional amendment is a separate statewide question. A majority of votes cast on a proposal determines its outcome. Neither this site nor the YES / NO color treatment endorses a position or political party.</p>
        <div class="mt-7 grid gap-4 md:grid-cols-3">
          <article class="glass-panel p-5">
            <h3 class="font-display text-3xl">What does YES mean?</h3>
            <p class="mt-2 text-sm leading-relaxed text-white/70">YES approves the proposed constitutional change. The exact effect depends on the amendment's language.</p>
          </article>
          <article class="glass-panel p-5">
            <h3 class="font-display text-3xl">What does NO mean?</h3>
            <p class="mt-2 text-sm leading-relaxed text-white/70">NO rejects that proposal. It does not change the constitution in the way proposed by that measure.</p>
          </article>
          <article class="glass-panel p-5">
            <h3 class="font-display text-3xl">Which ballot applies?</h3>
            <p class="mt-2 text-sm leading-relaxed text-white/70">All four are statewide. Your ballot may also contain local or county-specific constitutional amendments.</p>
            <a class="mt-4 inline-flex min-h-11 items-center text-sm text-gold-soft underline underline-offset-4" href={ballotUrl} target="_blank" rel="noopener noreferrer">Check official county sample ballots ↗</a>
          </article>
        </div>
      </div>
    </section>
  <NextStep />
  </main>
  <SiteFooter />
</Layout>
