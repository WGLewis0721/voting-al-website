---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Alabama Votes 2026 — Nonpartisan Voter Guide',
  description = 'Premium, nonpartisan Alabama voter education site for the 2026 elections.'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      tailwind = {
        config: {
          theme: {
            extend: {
              colors: {
                gold: { DEFAULT: '#c7a24f', soft: '#e4c77f', glow: '#f1d899' },
                graphite: { 950: '#090909', 900: '#111111' }
              },
              fontFamily: {
                display: ['Cormorant Garamond', 'serif'],
                sans: ['Outfit', 'system-ui', 'sans-serif']
              },
              boxShadow: {
                cinematic: '0 20px 80px rgba(0,0,0,.45)'
              }
            }
          }
        }
      };
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:bg-gold focus:text-black focus:px-3 focus:py-2 focus:rounded-md focus:z-[200]">Skip to main content</a>
    <slot />
  </body>
</html>
