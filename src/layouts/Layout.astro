---
import '../styles/global.css';
import assets from '../data/assets.json';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Alabama Votes 2026 — Nonpartisan Voter Guide',
  description = 'Premium, nonpartisan Alabama voter education site for the 2026 elections.'
} = Astro.props;
const siteOrigin = Astro.site ?? new URL('https://wglewis0721.github.io');
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;
const ogImageUrl = new URL(`${import.meta.env.BASE_URL}${assets.local.ogImage.path}`, siteOrigin).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Alabama Votes 2026" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Alabama Votes 2026: a nonpartisan voter guide with the Alabama shield" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#101114" />
    <script is:inline>
      (() => {
        const key = 'alabama-votes-color-mode';
        let chosen = null;
        try { chosen = localStorage.getItem(key); } catch {}
        const systemLight = window.matchMedia?.('(prefers-color-scheme: light)').matches;
        document.documentElement.dataset.theme =
          chosen === 'light' || chosen === 'dark' ? chosen : (systemLight ? 'light' : 'dark');
      })();
    </script>
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={assets.fonts.stylesheetUrl} rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}${assets.local.favicon.path}`} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:bg-gold focus:text-black focus:px-3 focus:py-2 focus:rounded-md focus:z-[200]">Skip to main content</a>
    <slot />
  </body>
</html>
